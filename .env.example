# Copy to .env and fill in. Never commit .env (it's gitignored).

# Quantiacs (free API key from https://quantiacs.com)
QUANTIACS_API_KEY=

# tastytrade (market data only; trades are placed manually)
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ENV=production   # or "sandbox"

# Optional extra data feeds
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
FRED_API_KEY=
